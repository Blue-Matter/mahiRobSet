nsim = 32*40
nsyr = 4
mus = log(c(1289, 1.27 / nsyr))
corl = -0.6
cv_Linf = 25.95 / mus[1]
cv_K = 0.08/1.27
sds = c(cv_Linf^2,cv_K^2)^0.5
