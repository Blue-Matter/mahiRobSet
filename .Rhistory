samps = rmvnorm(nsim,mus,vcv)
Linf = exp(samps[,1])
K = exp(samps[,2])
plot(Linf, K,xlab ="Asymptotic Length (mm) ('L-infinity')", ylab = "Maximum Growth Rate (K)")
