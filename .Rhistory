mus = log(c(1289, 1.27 / nsyr))
corl = -0.6
cv_Linf = 25.95 / exp(mus[1])
cv_K = 0.08/1.27
sds = c(cv_Linf^2,cv_K^2)^0.5
covar = corl * prod(sds)
vcv = matrix(c(cv_Linf^2, covar, covar, cv_K^2), nrow = 2, byrow=T)
samps = rmvnorm(nsim,mus,vcv)
Linf = exp(samps[,1])
K = exp(samps[,2])
plot(Linf, K,xlab ="Asymptotic Length (mm) ('L-infinity')", ylab = "Maximum Growth Rate (K)")
abline(v = exp(mus[1]), col="red", h = exp(mus[2]), lty=2,lwd=2)
ages = 1:16
nages = length(ages)
agemat = array(rep(ages,each=nsim),c(nsim,nages))-0.5
La = Linf * (1 - exp(-(K)*agemat))
matplot(ages, t(La), xlab="Age Class (quarter)", ylab = "Length(mm)")
matplot(ages, t(La[1:100,]), xlab="Age Class (quarter)", ylab = "Length(mm)")
matplot(ages, t(La[1:100,]), xlab="Age Class (quarter)", ylab = "Length(mm)",col="#99999960",type="l")
matplot(ages, t(La[1:200,]), xlab="Age Class (quarter)", ylab = "Length(mm)",col="#99999950",type="l",lwd=3)
matplot(ages, t(La[1:200,]), xlab="Age Class (quarter)", ylab = "Length(mm)",col="#99999950",type="l",lwd=3,lty = 1)
matplot(ages, t(La[1:200,]), xlab="Age Class (quarter)", ylab = "Length(mm)",col="#99999920",type="l",lwd=3,lty = 1)
matplot(ages, t(La[1:500,]), xlab="Age Class (quarter)", ylab = "Length(mm)",col="#99999920",type="l",lwd=2,lty = 1)
matplot(ages, t(La[1:500,]), xlab="Age Class (quarter)", ylab = "Length(mm)",col="#99999910",type="l",lwd=2,lty = 1)
matplot(ages, t(La[1:10,]), xlab="Age Class (quarter)", ylab = "Length(mm)",col="#99999910",type="l",lwd=2,lty = 1)
mLa = exp(mus[1]) * (1 - exp(-(mus[2])*ages))
lines(ages-0.5,mLa,col="red",lwd=2)
mLa
