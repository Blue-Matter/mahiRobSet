covar = corl * prod(sds)
vcv = matrix(c(cv_Linf^2, covar, covar, cv_K^2), nrow = 2, byrow=T)
samps = rmvnorm(nsim,mus,vcv)
Linf = exp(samps[,1])
K = exp(samps[,2])
plot(Linf, K,xlab ="Asymptotic Length (mm) ('L-infinity')", ylab = "Maximum Growth Rate (K)")
